type UserProfile = 
 record {
   bio: text;
   bloodType: text;
   dateOfBirth: text;
   isPrivate: bool;
   name: text;
   occupation: text;
   photoUrl: text;
 };
type TransformArg = 
 record {
   context: blob;
   response: HttpResponse;
 };
type Relationship = 
 variant {
   child;
   grandchild;
   grandparent;
   other;
   parent;
   sibling;
   spouse;
 };
type PersonProfile = 
 record {
   avatarUrl: text;
   bio: text;
   htmlUrl: text;
   login: text;
   name: text;
 };
type HttpResponse = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type FamilyMember = 
 record {
   bloodType: text;
   id: nat;
   isPublic: bool;
   medicalConditions: vec text;
   name: text;
   occupation: text;
   relationship: Relationship;
 };
type DiscoveredProduct = 
 record {
   brands: text;
   categories: text;
   imageUrl: text;
   productName: text;
 };
type DiscoveredBusiness = 
 record {
   address: text;
   category: text;
   name: text;
   phone: text;
   rating: text;
   website: text;
 };
service : {
  addFamilyMember: (member: FamilyMember) -> ();
  addMarriage: (spouse1: principal, spouse2: principal, marriageDate:
   text) -> ();
  claimAdmin: () -> (bool);
  followUser: (user: principal) -> ();
  getCallerUserProfile: () -> (opt UserProfile) query;
  getFamilyTree: () -> (vec FamilyMember) query;
  getFamilyTreeForUser: (user: principal) -> (vec FamilyMember) query;
  getFollowers: (user: principal) -> (vec principal) query;
  getPublicProfiles: () -> (vec UserProfile) query;
  getUserProfile: (user: principal) -> (opt UserProfile) query;
  isCallerAdmin: () -> (bool) query;
  isFollowing: (follower: principal, followee: principal) -> (bool) query;
  saveCallerUserProfile: (profile: UserProfile) -> ();
  searchBusinesses: (city: text, category: text) ->
   (variant {
      err: text;
      ok: vec DiscoveredBusiness;
    });
  searchPeople: (keyword: text) ->
   (variant {
      err: text;
      ok: vec PersonProfile;
    });
  searchProducts: (keyword: text) ->
   (variant {
      err: text;
      ok: vec DiscoveredProduct;
    });
  transformHttpResponse: (raw: TransformArg) -> (HttpResponse) query;
  unfollowUser: (user: principal) -> ();
}
